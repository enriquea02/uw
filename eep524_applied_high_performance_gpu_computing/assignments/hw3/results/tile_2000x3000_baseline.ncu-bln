QTriageCompute.l1tex__data_bytes_mem_shared_cmd_read_value_overhead.sum.per_secondShared Read OverheadJgb20x_TriageCompute_samplingzwTriageCompute.l1tex_data_bytes_per_wavefronts = ConversionFactorMetric(128.0, DimUnit.bytes / DimUnit.l1tex_wavefronts)zõTriageCompute.l1tex__data_bytes_mem_shared_cmd_read_value_overhead = CounterMetric(FMax(l1tex__data_pipe_lsu_wavefronts_mem_shared_op_ld * TriageCompute.l1tex_data_bytes_per_wavefronts - sm__bytes_mem_shared_cmd_read_realtime, ConstantCounterMetric(HwUnit.tpc, 0.0, DimUnit.bytes))) TriageCompute.l1tex__data_bytes_mem_shared_cmd_read_value_overhead:SetSustainedRate(128.0)"½
QTriageCompute.l1tex__data_bytes_mem_shared_cmd_atom_value_overhead.sum.per_secondShared Atom OverheadJgb20x_TriageCompute_samplingzwTriageCompute.l1tex_data_bytes_per_wavefronts = ConversionFactorMetric(128.0, DimUnit.bytes / DimUnit.l1tex_wavefronts)zºTriageCompute.l1tex__data_bytes_mem_shared_cmd_atom_value_overhead = CounterMetric(l1tex__data_pipe_lsu_wavefronts_mem_shared_op_atom * TriageCompute.l1tex_data_bytes_per_wavefronts - sm__bytes_mem_shared_cmd_atom_realtime) TriageCompute.l1tex__data_bytes_mem_shared_cmd_atom_value_overhead:SetSustainedRate(128.0)"€
