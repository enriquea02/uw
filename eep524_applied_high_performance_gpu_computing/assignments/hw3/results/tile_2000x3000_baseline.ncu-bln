@Compute_Triage.lts__throughput.avg.pct_of_peak_sustained_elapsedL2 ThroughputJgb10x_Compute_Triage_samplingzÍCompute_Triage.lts__throughput = ThroughputMetric({lts__xbar2lts_cycles_active,lts__lts2xbar_cycles_active_realtime,lts__t_requests,lts__t_sectors_realtime}, 'LTS Throughput (TriageCompute Configuration)')"Õ
CCompute_Triage.syslts__throughput.avg.pct_of_peak_sustained_elapsedSysL2 ThroughputJgb10x_Compute_Triage_samplingzÜCompute_Triage.syslts__throughput = ThroughputMetric({syslts__xbar2syslts_cycles_active,syslts__syslts2xbar_cycles_active,syslts__t_requests,syslts__t_sectors_realtime}, 'SYSLTS Throughput (TriageCompute Configuration)')"l
